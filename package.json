{
  "name": "hrms-backend",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS HRMS & Field Workforce Management platform - REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
